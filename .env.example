# CiteRAG Configuration

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+psycopg2://citerag:citerag_password@localhost:5432/citerag_db

# LLM Provider: 'auto', 'openai', 'gemini', 'groq', or 'mock'
LLM_PROVIDER=auto

# Provider API Keys (leave blank to use deterministic offline mock)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_MODEL=gpt-4o-mini

# Retrieval & Reranking Models
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Confidence & Thresholds
CONFIDENCE_THRESHOLD=-2.5
DENSE_TOP_K=20
BM25_TOP_K=20
RERANK_TOP_N=5
RRF_K=60
